# Canonical URL used for metadata, sitemap and robots (no trailing slash).
# On Vercel it falls back to the production URL when unset.
NEXT_PUBLIC_SITE_URL=https://www.getmoodi.dev

# Optional: DataFast bot traffic token (dfbot_…), server-side only. Create it in the
# DataFast dashboard under Bot traffic settings.
DATAFAST_BOT_TOKEN=

# Optional: DataFast website API key (df_…), server-side only; set it on Vercel. Sends
# server-side goals (e.g. hush_chat_message). Without it they are skipped.
DATAFAST_API=

# AI replies in the /test chat (server-side only). Without it the chat uses canned replies.
OPENAI_API_KEY=
# Optional, default gpt-4.1-mini
OPENAI_MODEL=
